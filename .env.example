# VERBAL configuration
#
# Nothing here is committed. Pass these at build time with --dart-define, or put
# them in a local JSON file and use --dart-define-from-file=env.json.
#
#   flutter run --dart-define-from-file=env.json
#
# Every key is optional. A missing key disables its feature and the app degrades
# to a working fallback rather than failing — see the README.

# Google Gemini. Without it the AI actor runs a scripted rehearsal.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ElevenLabs. Without it the actor speaks through the device's built-in voice.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# RevenueCat public SDK keys. Without them the app runs free-tier only and the
# paywall says purchasing is unavailable.
REVENUECAT_ANDROID_KEY=
REVENUECAT_IOS_KEY=

# OneSignal. Not wired into this build — see core/notifications.dart.
ONESIGNAL_APP_ID=
